Use DataDict.pkg

Open entrenador
Open equipo

//Tabla de Validación

Object oNacionalidadEntrenadorTable is a CodeValidationTable
    Set Type_Value to "NACIONALID"
    Set Allow_Blank_State to True 
End_Object

Class centrenadorDataDictionary is a DataDictionary
    
    Procedure Construct_Object
        Forward Send Construct_Object
        Set Main_File to entrenador.File_Number

        Set Add_Server_File to equipo.File_Number
        
        Set Field_Value_Table Field entrenador.Nacionalidad to oNacionalidadEntrenadorTable

        Set ParentNullAllowed equipo.File_Number to True //Para que el padre pueda ser null

        Set Foreign_Field_Option DD_KEYFIELD DD_NOPUT to True
        Set Foreign_Field_Option DD_KEYFIELD DD_FINDREQ to True
        Set Foreign_Field_Option DD_INDEXFIELD DD_NOPUT to True
        Set Foreign_Field_Option DD_DEFAULT DD_DISPLAYONLY to True

        Set Key_Field_State Field entrenador.ID to True

        Set Field_Option Field entrenador.Nombre DD_NOPUT to True
        Set Field_Option Field entrenador.Nombre DD_REQUIRED to True

        Set Field_Option Field entrenador.Apellido DD_NOPUT to True
        Set Field_Option Field entrenador.Apellido DD_REQUIRED to True

    End_Procedure
    
    Procedure Save_Main_File
        Integer iEquipo
        
        Get Field_Current_Value Field entrenador.EquipoID to iEquipo
        
        If (iEquipo = 0) Begin
            Set_Attribute DF_FIELD_IS_NULL of entrenador.File_Number 5 to True 
        End
        Else Begin
            Set_Attribute DF_FIELD_IS_NULL of entrenador.File_Number 5 to False
        End
        
        Forward Send Save_Main_File
    End_Procedure

End_Class