// C:\DataFlex Projects\FutbolWebApp\AppSrc\SelectJugadorPosicion.wo
// SelectJugadorPosicion
//

Use cWebView.pkg
Use cWebPanel.pkg
Use cWebGroup.pkg
Use cWebList.pkg
Use cWebColumn.pkg
Use cWebButton.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg
Use ZoomJugadorPosicion.wo

Use cligaDataDictionary.dd
Use cequipoDataDictionary.dd
Use cjugadorDataDictionary.dd
Use cposicionDataDictionary.dd
Use cjugadorposicionDataDictionary.dd

Object oSelectJugadorPosicion is a cWebView
    Set psCaption to "Posiciones"
    Set peWebViewStyle to wvsDrilldown
    Set peViewType to vtSelect
    Set piColumnCount to 12
    Set pbShowCaption to True
    Set piMaxWidth to 1024

    Object oliga_DD is a cligaDataDictionary
    End_Object 

    Object oequipo_DD is a cequipoDataDictionary
        Set DDO_Server to oliga_DD
    End_Object 

    Object ojugador_DD is a cjugadorDataDictionary
        Set DDO_Server to oequipo_DD
    End_Object 

    // Posición como padre de jugadorposicion (se usa al guardar)
    Object oposicion_DD is a cposicionDataDictionary
    End_Object 

    // Posición independiente, solo para la lista de posiciones totales
    Object oposicionTotal_DD is a cposicionDataDictionary
    End_Object 

    Object ojugadorposicion_DD is a cjugadorposicionDataDictionary
        Set DDO_Server to ojugador_DD
        Set DDO_Server to oposicion_DD
        Set Constrain_File to jugador.File_Number
    End_Object 

    Set Main_DD to ojugadorposicion_DD
    Set Server  to ojugadorposicion_DD

    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 12
        WebSetResponsive piColumnCount rmMobile to 4

        Object oPosicionesTotalesList is a cWebList
            Set Server to oposicionTotal_DD
            Set piColumnSpan to 5
            Set piColumnIndex to 0
            Set pbServerOnRowClick to True
            Set psCaption to "Posiciones Totales"

            Object oPosicionTotalNombre is a cWebColumn
                Entry_Item posicion.Nombre
                Set psCaption to "Posiciones Totales"
                Set piWidth to 200
            End_Object 
        End_Object 

        Object oBotonesGroup is a cWebGroup
            Set piColumnSpan to 2
            Set piColumnIndex to 5
            Set piColumnCount to 1
            Set pbShowBorder to False

            Object oAnadirBtn is a cWebButton
                Set psCaption to "->"
                Set piColumnSpan to 1
                Set piColumnIndex to 0

                Procedure OnClick
                    Integer iJugadorID iPosicionID
                    Boolean bYaExiste
                    String sRowId
                    RowID riPosicion

                    Get Field_Current_Value of ojugador_DD Field jugador.ID to iJugadorID
                    WebGet psCurrentRowId of oPosicionesTotalesList to sRowId
                    If (iJugadorID <= 0 or sRowId = "") Begin
                        Send ShowInfoBox "Selecciona primero una posición de la lista de la izquierda." "Posiciones"
                        Procedure_Return
                    End

                    Move (DeserializeRowId(sRowId)) to riPosicion
                    Send Clear of ojugadorposicion_DD
                    Send FindByRowId of oposicion_DD posicion.File_Number riPosicion
                    Move posicion.ID to iPosicionID

                    // Comprobar duplicado
                    Move False to bYaExiste
                    Clear jugadorposicion
                    Find GT jugadorposicion by Index.1
                    While (Found)
                        If (jugadorposicion.JugadorID = iJugadorID and jugadorposicion.PosicionID = iPosicionID) Begin
                            Move True to bYaExiste
                        End
                        Find GT jugadorposicion by Index.1
                    Loop

                    If (bYaExiste) Begin
                        Send ShowInfoBox "El jugador ya tiene esta posición asignada." "Posición duplicada"
                        Procedure_Return
                    End

                    Send Request_Save of ojugadorposicion_DD
                    Send RefreshListFromDD of oPosicionesJugadorList
                End_Procedure
            End_Object 

            Object oQuitarBtn is a cWebButton
                Set psCaption to "<-"
                Set piColumnSpan to 1
                Set piColumnIndex to 0

                Procedure OnClick
                    String sRowId
                    RowID riRelacion

                    WebGet psCurrentRowId of oPosicionesJugadorList to sRowId
                    If (sRowId = "") Begin
                        Send ShowInfoBox "Selecciona primero una posición del jugador." "Posiciones"
                        Procedure_Return
                    End

                    Move (DeserializeRowId(sRowId)) to riRelacion
                    Send FindByRowId of ojugadorposicion_DD jugadorposicion.File_Number riRelacion
                    Send Request_Delete of ojugadorposicion_DD
                    Send RefreshListFromDD of oPosicionesJugadorList
                End_Procedure
            End_Object 
        End_Object 

        Object oPosicionesJugadorList is a cWebList
            Set Server to ojugadorposicion_DD
            Set piColumnSpan to 5
            Set piColumnIndex to 7
            Set pbServerOnRowClick to True
            Set psCaption to "Posiciones del jugador"

            Object oPosicionJugadorNombre is a cWebColumn
                Entry_Item posicion.Nombre
                Set psCaption to "Posiciones del jugador"
                Set piWidth to 200
            End_Object 
        End_Object 
    End_Object 

    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
        String sNombre sApellido

        Forward Send OnNavigateForward NavigateData hoInvokingView hoInvokingObject
        Get Field_Current_Value of ojugador_DD Field jugador.Nombre to sNombre
        Get Field_Current_Value of ojugador_DD Field jugador.Apellido to sApellido
        WebSet psCaption to ("Posiciones de: " + Trim(sNombre) + " " + Trim(sApellido))

        Send RefreshListFromDD of oPosicionesTotalesList
        Send RefreshListFromDD of oPosicionesJugadorList
    End_Procedure

End_Object