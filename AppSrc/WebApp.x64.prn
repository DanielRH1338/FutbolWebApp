39495>>>                // If from main, this is a probably a main-file lookup from a Zoom
39495>>>                WebSet pbRender of oDetailButton to False
39496>>>                Case Break
39497>>>
39497>>>            Case Else // must be nfUndefined
39497>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
39497>>>                // If Row select does main-zoom we don't need this
39497>>>                WebSet pbRender of oDetailButton to False
39498>>>
39498>>>        Case End
