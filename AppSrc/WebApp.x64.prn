38358>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38361>>>        Case Begin
38361>>>            Case (NavigateData.eNavigateType = nfFromMain)
38363>>>                // If from main, this is a propbably a main file Select to Zoom.
38363>>>                Case Break
38364>>>
38364>>>            Case (NavigateData.eNavigateType = nfFromParent)
38367>>>                // If from parent, this is a constrained drill down.
38367>>>                Case Break
38368>>>
38368>>>            Case (NavigateData.eNavigateType = nfFromChild)
38371>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38371>>>                Case Break
38372>>>
38372>>>            Case Else // must be nfUndefined
38372>>>
38372>>>        Case End
38372>>>
38372>>>        Send SetActionButtons
38373>>>
38373>>>    End_Procedure
