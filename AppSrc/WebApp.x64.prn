37888>>>
37888>>>            Case Else // must be nfUndefined
37888>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
37888>>>                // If Row select does main-zoom we don't need this
37888>>>                WebSet pbRender of oDetailButton to False
37889>>>
37889>>>        Case End
