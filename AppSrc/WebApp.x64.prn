39019>>>    Procedure SetActionButtons
39022>>>        tWebNavigateData NavigateData
39022>>>        tWebNavigateData NavigateData
39022>>>        Boolean bHasRecord
39022>>>        Handle hoDD
39022>>>
39022>>>        Get Server to hoDD
39023>>>        Get GetNavigateData to NavigateData
39024>>>        Get HasRecord of hoDD to bHasRecord
39025>>>
39025>>>        // let's hide all buttons and then Show the ones we want
39025>>>        WebSet pbRender of oEditBtn to False
39026>>>        WebSet pbRender of oSaveBtn to False
39027>>>        WebSet pbRender of oCancelChangesBtn to False
39028>>>        WebSet pbRender of oDeleteBtn to False
39029>>>
39029>>>        If (NavigateData.bReadOnly) Begin
39031>>>            WebSet pbRender of oEditBtn to True
39032>>>        End
39032>>>>
39032>>>        Else Begin
39033>>>            WebSet pbRender of oSaveBtn to True
39034>>>            WebSet pbRender of oCancelChangesBtn to True
39035>>>            WebSet pbRender of oDeleteBtn to bHasRecord
39036>>>        End
39036>>>>
39036>>>    End_Procedure
