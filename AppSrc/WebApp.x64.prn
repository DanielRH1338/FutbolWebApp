39052>>>                Case Break
39053>>>
39053>>>            Case (NavigateData.eNavigateType = nfFromParent)
39056>>>                // If from parent, this is a constrained drill down.
39056>>>                Case Break
39057>>>
39057>>>            Case (NavigateData.eNavigateType = nfFromChild)
39060>>>                // If from child, this is a probably a parent Zoom from a Zoom.
39060>>>                Case Break
39061>>>
39061>>>            Case Else // must be nfUndefined
39061>>>
39061>>>        Case End
39061>>>
39061>>>        Send SetActionButtons
39062>>>
39062>>>    End_Procedure
39063>>>
39063>>>End_Object 
