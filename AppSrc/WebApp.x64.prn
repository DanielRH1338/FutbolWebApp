38529>>>        WebSet pbRender of oNewButton to True
38530>>>        WebSet pbRender of oDetailButton to True
38531>>>
38531>>>        Case Begin
38531>>>            Case (NavigateData.eNavigateType = nfFromParent)
38533>>>                // If from parent, this is a constrained drill down
38533>>>                // If Row select does main-zoom we don't need this
38533>>>                WebSet pbRender of oDetailButton to False
38534>>>                Case Break
38535>>>
38535>>>            Case (NavigateData.eNavigateType = nfFromChild)
38538>>>                // If from child, this is a probably a parent lookup from a Zoom
38538>>>                Case Break
38539>>>
38539>>>            Case (NavigateData.eNavigateType = nfFromMain)
38542>>>                // If from main, this is a probably a main-file lookup from a Zoom
38542>>>                WebSet pbRender of oDetailButton to False
38543>>>                Case Break
38544>>>
38544>>>            Case Else // must be nfUndefined
38544>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
38544>>>                // If Row select does main-zoom we don't need this
38544>>>                WebSet pbRender of oDetailButton to False
38545>>>
38545>>>        Case End
38545>>>
38545>>>    End_Procedure
